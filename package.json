{
  "name": "next-link-no-autoprefetch-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace for @vividwebau/next-link-no-autoprefetch and its ESLint plugin.",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:test-app": "pnpm --filter vividweb-test-app dev",
    "build:test-app": "pnpm --filter vividweb-test-app build",
    "build:lib": "pnpm --filter next-link-no-autoprefetch build"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "@types/node": "^20.11.30"
  }
}
